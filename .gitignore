# beet's tofu work dir for the assets bucket (`just assets ..`)
target/
.agents/*
!.agents/skills
# device handoffs, see the device-handoff skill
!.agents/tasks
# backup files generated by omarchy update
**/*.bak.**

# audio clips captured by scripts/transcribe.sh
*.wav
out.txt
.env

# belt and braces: private keys must never land in here. Only stow/ssh/.ssh/config
# is tracked; keys are generated per device straight into ~/.ssh
stow/ssh/.ssh/id_*
!stow/ssh/.ssh/id_*.pub

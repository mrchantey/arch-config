// Zed settings
// https://zed.dev/docs/configuring-zed
{
	// "show_completions_on_input": false,
	"git_commit_buffer_font_size": 20.0,
	// Agents run behind ~/me/arch-config/scripts/acp-tee.sh, which taps the ACP stream on its way
	// to Zed so CTRL+PAUSE can read the last reply aloud (see scripts/acp-last.sh). The
	// tap is protocol-level, so the same wrapper fits any agent listed here.
	//
	// Cost of "type": "custom" is that Zed no longer installs or updates the adapter;
	// `just install-mise-tools` owns it now. To hand it back, delete the command/args/env
	// lines and set "type": "registry".
	"agent_servers": {
		"claude-acp": {
			"default_config_options": {
				"fast": false,
    "effort": "xhigh",
				"model": "opus[1m]",
				"mode": "bypassPermissions",
			},
			"favorite_config_option_values": {
				"mode": ["auto", "bypassPermissions"],
			},
			"type": "custom",
			"command": "/home/pete/me/arch-config/scripts/acp-tee.sh",
			"args": ["/home/pete/.local/bin/claude-agent-acp"],
			"env": { "ACP_TEE_NAME": "claude" },
		},
		// To tap this one too, same treatment: "type": "custom", command acp-tee.sh,
		// args pointing at opencode's own ACP entry point.
		"opencode": {
			"type": "registry",
		},
	},
	"restore_on_startup": "empty_tab",
	"cli_default_open_behavior": "new_window",
	"git_panel": {
		"tree_view": false,
  "group_by": "staging",
  "sort_by":"path",
		"dock": "left",
	},
	"session": {
		"trust_all_worktrees": true,
	},
	"disable_ai": false,
	"diff_view_style": "unified",
	"agent_buffer_font_size": 19.0,
	"project_panel": {
		"dock": "left",
		"hide_hidden": false,
	},
	"inlay_hints": {
		"enabled": false,
	},
	// AGENTS
	"agent": {
		"sandbox_permissions": {
   "allow_unsandboxed": true
  },
  "sidebar_side": "right",
		"dock": "right",
		"default_profile": "write",
		"inline_assistant_model": {
			"provider": "google",
			"model": "gemini-3.5-flash",
			"enable_thinking": false,
		},
		"default_model": {
			"effort": "medium",
			"provider": "google",
			"model": "gemini-3.7-flash",
			"enable_thinking": true,
		},

		"favorite_models": [
   {
    "provider": "copilot_chat",
    "model": "claude-sonnet-4.6",
    "enable_thinking": true,
    "effort": "high"
   },
   {
    "provider": "anthropic",
    "model": "claude-opus-4.6",
    "enable_thinking": true,
    "effort": "high"
   },
   {
    "provider": "openai-subscribed",
    "model": "gpt-5.6-sol",
    "enable_thinking": true,
    "effort": "high"
   },
   {
    "provider": "openai-subscribed",
    "model": "gpt-6-astra",
    "enable_thinking": true,
    "effort": "high"
   },
   {
    "provider": "openai-subscribed",
    "model": "gpt-5.6-terra",
    "enable_thinking": true,
    "effort": "medium"
   }
  ],
		"model_parameters": [],
		"tool_permissions": {
			"default": "allow",
		},
	},
	// "completions": {
	// 	"words": "disabled"
	// },
	"edit_predictions": {
		"copilot": {
			"enable_next_edit_suggestions": true,
		},
		"provider": "copilot",
		"mode": "subtle",
	},
	//
	//
	//
	//
	"auto_install_extensions": {
		"html": true,
		"toml": true,
		"just": true,
		"deno": true,
		"git-firefly": true,
	},
	"snippet_sort_order": "top",
	// "autosave": "on_focus_change",
	"autosave": { "after_delay": { "milliseconds": 1000 } },
	"file_types": {
		"JSONC": [
			"**/.zed/**/*.json",
			"**/zed/**/*.json",
			"**/Zed/**/*.json",
			"**/.vscode/**/*.json",
		],
		"Shell Script": [".env.*"],
		"TOML": ["**/.config/hypr/**/*.conf"],
		"HTML": ["*.bsx"],
	},
	"hard_tabs": true,
	"indent_guides": {
		"coloring": "indent_aware",
		"active_line_width": 2,
		"line_width": 2,
	},
	"ui_font_size": 24.0,
	"agent_ui_font_size": 23.0,
	"buffer_font_size": 20.0,
	"colorize_brackets": true,
	"language_models": {
		// "bedrock": {

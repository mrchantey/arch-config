{
  "version": 1,
  "idle": {
    "screensaver": 1260,
    "lock": 1200
  },
  "bar": {
    "position": "top",
    "background": "opaque",
    "layout": {
      "left": [
        { "id": "omarchy.menu" },
        { "id": "pete.workspaces" }
      ],
      "centerBegin": [
        { "id": "omarchy.indicators" }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "HH:mm · dddd 'W'ww · dd MMMM yyyy",
          "formatAlt": "dd MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen",
          "cities": [
            { "name": "Sydney", "zone": "Australia/Sydney" },
            { "name": "Los Angeles", "zone": "America/Los_Angeles" },
            { "name": "New York", "zone": "America/New_York" },
            { "name": "London", "zone": "Europe/London" },
            { "name": "Dubai", "zone": "Asia/Dubai" }
          ]
        },
        { "id": "omarchy.system-update" }
      ],
      "right": [
        { "id": "omarchy.tray" },
        { "id": "omarchy.agents" },
        { "id": "omarchy.bluetooth" },
        { "id": "omarchy.network" },
        { "id": "omarchy.audio" },
        { "id": "omarchy.monitor" },
        { "id": "omarchy.power" }
      ],
      "tray": []
    }
  },
  "plugins": [
    { "id": "io.voxtype.settings" }
  ]
}

<!--
# arch-config buckets

Two buckets in one stack.

The shared assets bucket, `arch-config--shared--assets`: the source of record
for files shared across machines but too large or too personal for git
(wallpapers, headshots, the omarchy-logo template). `assets/` is a manifest of
symlinks, one per noun, each pointing at where that noun lives on the machine
(`assets/pictures -> ~/Pictures/assets`), and a push materializes the tree
under the same prefixes in the bucket.

The backup bucket, `arch-config--shared--backup`: private, one prefix per
device, each a mirror of the tree `scripts/backup.sh` stages under
`target/backup/<device>`, laid out as the device's home directory
(`silver-fox/me/beet/.agents/..`). Driven by `just backup` and `just restore`
(docs/backups.md).

    just assets plan       # eyeball the plan
    just assets deploy --dry-run   # each credential, what it would become, and whether --elevated is needed
    just assets deploy --elevated  # converge the account and the deploy user, policy and key as an administrator, then deploy
    just assets deploy     # provision the buckets
    just assets push       # mirror assets/ up, pruning what was removed locally
    just assets backup/push/<device>  # mirror target/backup/<device> up
    just assets backup/pull/<device>  # hydrate target/restore/<device> from the bucket
    just assets destroy    # tear the stack down (refused while a bucket holds objects)
    just assets secrets ls # the age-sealed records of secrets.toml
    just assets secrets check  # whether this machine's age identity opens them

There is no beet `pull` for assets: hydrating is `just pull-assets`, a credential-free
`aws s3 sync` that `init-user` runs on a fresh machine before any Rust
toolchain exists, which is what the bucket's public read is for.

The deploy verbs need the aws deploy pair and this stack's tofu state
passphrase, both `env_var` records of the committed `secrets.toml`, age-sealed
and loaded into the process environment by the launch before the entry builds;
nothing reads `~/.aws`. The pair is this repo's own IAM user,
`arch-config-deploy`, in this repo's own AWS account (`arch-config`, a member
of the operator's Organization), reaching this stack's bucket namespace and
state key and nothing else. A plain deploy checks the pair against what the
stack renders and refuses, naming `--elevated`, when it needs more than it was
granted, ie after a new bucket; `just assets deploy --elevated` asks for the
administrator's six-digit code and converges the account, the user, its
`arch-config--deploy` policy and its key, since a deploy credential holds no
`iam:` action over itself. The state passphrase is this repo's own, minted
here and shared with no other repo, so losing it costs this stack's state and
nothing else. Reading the document needs this machine's age identity
(`~/.config/beet/age/keys.txt`).
-->
<CliServer always=true {CallOnReady}>
<Router {HelpHandler}>
	<!-- the stock beet binary built with `infra,extra`, which `just assets` does;
	     a lean beet resolves none of the tags below -->
	<RequireCfg cfg="feature:infra && feature:extra"/>
	<!-- `app_name` composes the bucket name and the tofu state key, so renaming
	     it would orphan the bucket -->
	<PackageConfig title="Arch Config" app_name="arch-config" description="Shared assets and device backups for the omarchy config"/>
	<!-- this repo's credentials (the aws deploy pair, its own tofu state
	     passphrase), age-sealed in `secrets.toml` and loaded into the process
	     environment by the launch before this entry builds; no `bx:cfg`, since
	     the prescan reads the declaration ahead of the build walk -->
	<Secrets/>
	<Route path="secrets" bx:cfg="feature:vault"><SecretsRoutes/></Route>
	<!-- this machine's OWN aws identity: `just assets aws -- ..` runs as the
	     read-only `beet-agent` or under a live admin session, and
	     `--account=arch-config` inside this repo's own account; `just assets
	     admin` buys that session with one code from the phone, and
	     `admin -- <verb>` runs one of this entry's verbs under it -->
	<AwsExec bx:cfg="feature:vault"/>
	<AdminElevate bx:cfg="feature:vault"/>
	<!-- the aws identity this repo deploys as: one iam user for this document
	     and one managed policy per app it declares, lowered from what the stack
	     below renders. A deploy checks it against the declarations before it
	     writes anything, and an elevated deploy converges it as an
	     administrator: the scoped pair it seals cannot mint itself -->
	<AwsDeployCredential/>
	<!-- the repo's own AWS account, a member of the Organization the deploy
	     credential lives and deploys in. The root carries no region, so it is
	     spread here: the state bucket and the Recycle Bin rules land there -->
	<AwsAccount name="arch-config" {AwsRegion("us-west-2")}/>
	<!-- `close-account --elevated`: the package's most final act, stated where
	     the account is -->
	<CloseDeployAccounts/>
	<!-- `shared`: a source synced between machines is owned by no deploy stage.
	     The region is pinned because the unsigned urls in the justfile and the
	     omarchy-logo skill name it, and a provider address is a spread resolved
	     by ancestry rather than a field on the stack. -->
	<Stack stage="shared" {AwsRegion("us-west-2")}>
		<!-- public read (GetObject + ListBucket) so a fresh machine hydrates
		     unsigned; never force-destroyed; versioned so a bad mirror push is
		     recoverable for 90 days -->
		<S3BucketBlock bx:ref="assets" label="assets" deploy_versioned=false public_read=true force_destroy=false object_versioning=true/>
		<Group bx:ref="deploy_up">
			<TofuApply/>
		</Group>
		<Group bx:ref="deploy_down">
			<StackTeardown/>
			<TofuDestroy/>
		</Group>
		<DeployRoutes deploy={$deploy_up} destroy={$deploy_down}/>
		<!-- a mirror: what was removed locally is removed from the bucket.
		     `follow_symlinks` materializes each noun's link, and the push refuses
		     an empty or unhydrated one, which is what makes the delete safe -->
		<Route path="push" {ExchangeSequence}>
			<StoreSync src="fs:assets" dest={$assets} delete=true follow_symlinks=true/>
		</Route>
		<!-- private, never force-destroyed, versioned so a pruning push is
		     recoverable for 90 days -->
		<S3BucketBlock bx:ref="backup" label="backup" deploy_versioned=false force_destroy=false object_versioning=true/>
		<!-- one push and one pull per device, since the device's folder is declared
		     rather than read from the request. The push mirrors the staged tree, so a file
		     removed locally is pruned from the device's prefix and no other; a
		     staged symlink is skipped, git restores those. The pull lands beside
		     the staging tree rather than in it, so a restore never feeds a push -->
		<Route path="backup/push/silver-fox" {ExchangeSequence}>
			<StoreSync src="fs:target/backup/silver-fox" dest={$backup} dest_dir="silver-fox" delete=true/>
		</Route>
		<Route path="backup/pull/silver-fox" {ExchangeSequence}>
			<StoreSync src={$backup} src_dir="silver-fox" dest="fs:target/restore/silver-fox"/>
		</Route>
		<Route path="backup/push/rainbow-cat" {ExchangeSequence}>
			<StoreSync src="fs:target/backup/rainbow-cat" dest={$backup} dest_dir="rainbow-cat" delete=true/>
		</Route>
		<Route path="backup/pull/rainbow-cat" {ExchangeSequence}>
			<StoreSync src={$backup} src_dir="rainbow-cat" dest="fs:target/restore/rainbow-cat"/>
		</Route>
	</Stack>
</Router>
</CliServer>
